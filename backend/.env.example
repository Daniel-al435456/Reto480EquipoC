# Copia este fichero a `.env` y completa los valores.
# `.env` está en `.gitignore`: nunca se sube al repositorio.

# Servidor de PostgreSQL. El usuario y la contraseña van aquí, no en el código.
DATABASE_URL=postgresql+psycopg://USUARIO@localhost:5432/reto480

# Clave de la API de Groq. Solo la persona que despliegue la conoce.
# Sin ella, el diagnóstico y el mentor usan sus respuestas de respaldo.
GROQ_API_KEY=

# Modelos de los agentes (opcional; por defecto, los aprobados en P1).
# MODELO_DIAGNOSTICO=openai/gpt-oss-20b
# MODELO_MENTOR=openai/gpt-oss-120b
# MODELO_CORRECCION=openai/gpt-oss-20b

# Origen del frontend permitido por CORS. Varios, separados por comas.
FRONTEND_URL=http://localhost:5173

# Desarrollo, pruebas o producción.
ENTORNO=desarrollo
